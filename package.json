{
  "name": "ekstraklasa-xi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "tsx --test src/",
    "sync": "tsx src/sync/run.ts",
    "sync:2026": "tsx src/sync/run.ts --predict-only",
    "sync:pl": "tsx src/sync/run.ts --predict-only --league=39",
    "sync:preseason": "tsx src/sync/run.ts --preseason-only --league=106,39",
    "sync:expand": "tsx src/sync/runExpandLeagues.ts",
    "sync:manager": "tsx src/sync/runManagerFormations.ts",
    "sync:managers": "tsx src/sync/runManagerFormations.ts --league=106,39 --sample=100",
    "sync:mantra": "tsx src/sync/runMantra.ts",
    "collect:mantra-auction": "tsx src/sync/runMantraAuction.ts",
    "collect:mantra-auctions": "tsx src/sync/runMantraAuctions.ts",
    "retry:mantra-auctions": "tsx src/sync/runMantraAuctions.ts --retry-failed",
    "sync:mantra-match": "tsx src/sync/runMantraMatch.ts",
    "sync:mantra-tours": "tsx src/sync/runMantraTours.ts",
    "sync:mantra-lineups": "tsx src/sync/runMantraLineups.ts",
    "sync:odds": "tsx src/sync/runOdds.ts",
    "sync:live": "tsx src/sync/runLive.ts",
    "sync:stats": "tsx src/sync/runPlayerStatsHistory.ts",
    "sync:sorare": "tsx src/sync/runSorare.ts",
    "expected11": "tsx src/sync/runExpected11.ts",
    "import:serie-a-xi": "tsx src/sync/runSerieALineupPredictions.ts",
    "import:footmops": "tsx src/sync/runFootmops.ts",
    "expected11:web": "tsx src/expected11-server.ts",
    "sync:tm": "tsx src/sync/runTmLeague.ts",
    "sync:tm:all": "tsx src/sync/runExpandLeagues.ts --skip-af --skip-mantra --skip-managers",
    "sync:league-one": "tsx src/sync/runLeagueOne.ts",
    "sync:league-one-matches": "tsx src/sync/runLeagueOneMatches.ts",
    "start:tm": "tsx src/tm-server.ts",
    "dev:tm": "tsx watch src/tm-server.ts",
    "worker:live-poll": "tsx src/workers/liveDataPoll.ts",
    "worker:live-compute": "tsx src/workers/liveCompute.ts",
    "db:reset": "rm -f data/app.db data/app.db-wal data/app.db-shm"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "linkedom": "^0.18.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "playwright": "^1.62.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
