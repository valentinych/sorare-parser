API_FOOTBALL_KEY=your_api_sports_key_here
PORT=3000
LEAGUE_ID=106
# Optional: sync multiple leagues, e.g. LEAGUE_IDS=106,39
# LEAGUE_IDS=39
SEASON=2025
PREDICT_SEASON=2026
PRESEASON_FROM=2026-06-01
# PL club friendlies often run into mid-August
PRESEASON_TO=2026-08-20
# MantraFootball login (for fantasy match lineups). Do not commit real values.
# MANTRA_EMAIL=
# MANTRA_PASSWORD=

# Google OAuth for mantra.panenka.games
PUBLIC_URL=https://mantra.panenka.games
GOOGLE_REDIRECT_URI=https://mantra.panenka.games/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional Sorare API key. Anonymous reads are rate-limited to 20 requests/min.
# SORARE_API_KEY=
# Optional official Sorare JWT login (60 requests/min). Password must already be
# bcrypt-hashed as documented at https://github.com/sorare/api — never plaintext.
# SORARE_EMAIL=
# SORARE_PASSWORD_HASH=
# SORARE_JWT_AUD=mantra-panenka-games
# SORARE_POLL_INTERVAL_MS=1800000

# Required on both the local Expected11 runner and production server to enable
# the explicit sanitized JSON publish action. Use the same random secret.
# EXPECTED11_IMPORT_TOKEN=
# Same bearer token authorizes POST /api/expected11/import and /api/footmops/import on production.
# Headless Chromium for Expected11 rebuild in Docker (fallback if Chrome is
# not in the image). Local headed parser uses installed Google Chrome:
# npm run expected11:web (profile: data/expected11/chrome-profile; sign in
# with Expected11 email/password in the headed Chrome window, not Google).
# Optional prefill only — leave unset to type credentials in Chrome yourself.
# EXPECTED11_EMAIL=
# EXPECTED11_PASSWORD=
# EXPECTED11_HEADLESS=1
# SorareInside tab (same UI: npm run expected11:web) uses a separate Chrome
# profile at data/sorare/chrome-profile. Screenshots → data/sorare/output/{round}/{club}.png
# Manual login in Chrome is preferred; optional headless flag mirrors Expected11.
# SORAREINSIDE_HEADLESS=1
# Required on the local auction collector and production server for incremental
# normalized auction imports. Generate a separate random secret.
# MANTRA_AUCTION_IMPORT_TOKEN=
# Comma-separated verified Google account emails allowed to use Premium.
# LIVE_DRAFT_EMAILS also get Premium (union). Mapping and Expected11 URL ingest
# stay admin-only. Never commit real account emails.
# EXPECTED11_PREMIUM_EMAILS=you@example.com
# Comma-separated verified Google account emails allowed to see the hidden
# Premier League live draft tab (and Premium). Empty or omitted = nobody.
# Add participants later by appending emails here and restarting the server.
# Never commit real account emails.
# LIVE_DRAFT_EMAILS=you@example.com

