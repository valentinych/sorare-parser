{
  "manifest_version": 3,
  "name": "Mantra Sorare Browser Import",
  "version": "1.0.0",
  "description": "Imports visible Sorare Inside Companion projection ribbons into your Mantra account.",
  "key": "",
  "permissions": [],
  "host_permissions": [
    "https://sorare.com/*",
    "https://mantra.panenka.games/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://sorare.com/*"],
      "js": ["parser.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
